{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "api/*.js",   "use": "@vercel/node"   }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/",         "dest": "/index.html" },
    { "src": "/index",    "dest": "/index.html" },
    { "src": "/index.html","dest": "/index.html" }
  ],
  "functions": {
    "api/claude.js": { "maxDuration": 30 }
  }
}
